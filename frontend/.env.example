# Copy to frontend/.env — everything here is optional.
# The app runs on its local data layer with no configuration at all.

# Base URL of the Spring Boot backend (see ../backend). When it is running the
# app uses it automatically; otherwise it falls back to localStorage.
VITE_API_BASE_URL="http://localhost:8080/api/v1"

# Optional: a real OpenAI key enables live AI-assistant responses.
# Without it the assistant uses built-in mock responses.
VITE_OPENAI_API_KEY=""
VITE_OPENAI_MODEL="gpt-4o-mini"
