# Copy to backend/.env and source it, or export these before `mvn spring-boot:run`.
# Every value below is also the built-in default — nothing here is required for
# a standard local setup with MySQL on :3306.

APP_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

DB_HOST=localhost
DB_PORT=3306
DB_NAME=campus_connect
DB_USERNAME=root
DB_PASSWORD=2407

# "dev" = bearer token is a profile id (no external IdP). "clerk" = validate JWTs.
AUTH_MODE=dev

# Only needed when AUTH_MODE=clerk
CLERK_ISSUER_URL=
CLERK_JWKS_URL=
CLERK_WEBHOOK_SECRET=dummy_secret

FILE_STORAGE_MODE=local
FILE_STORAGE_ROOT=./uploads
